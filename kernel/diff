-		}
-
-		if (!merged)
-			__insert_discard_cmd(sbi, bdev,
-						di.lstart, di.start, di.len);
- next:
-		prev_dc = next_dc;
-		if (!prev_dc)
-			break;
-
-		node = rb_next(&prev_dc->rb_node);
-		next_dc = rb_entry_safe(node, struct discard_cmd, rb_node);
-	}
-}
