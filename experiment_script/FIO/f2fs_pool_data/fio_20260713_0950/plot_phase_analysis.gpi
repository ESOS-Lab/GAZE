#kiops
set terminal postscript eps enhanced color dashed dashlength 3 \
	                linewidth 2 rounded font "Helvetica, 32"

fn(v) = sprintf("%.1f", v)
fnn(v) = sprintf("%d", v)
jw_fnn(v) = (v < 100)? fn(v) : fnn(v)

#set output "./graph_fio_cmp_kiops.eps"
set output "./gc_phase_latency_breakdown.eps"
#set term postscript size 7.5,3.
#set term postscript size 7.5,2.8+0.4+0.4
set term postscript size 2.95,2.8+0.4+0.4
set key outside right top vertical reverse invert Left font "Helvetica, 34"

set key samplen 1 width 0.2

set xtics nomirror
set ytics nomirror

set xtics font "Helvetica, 38" offset 0, 1.5 

#set xrange[-0.5:3.5]
set xrange[-0.5:1.7]
set yrange[0:2.0]
#set key at 0.6, 1.5
set key at 1.55, 2.0
set ytics 0.4 font "Helvetica, 38"

set ylabel font "Helvetica, 38" "Elapsed Time (sec)" offset 1.3, -0.5
#set xlabel font "Helvetica, 38" "Victim Zone Utilization (\%)" offset 0.1, 0.3
unset xlabel

set lmargin at screen 0.31
set rmargin at screen 0.99
#set bmargin at screen 0.23
#set tmargin at screen 0.98 - 0.05

#set style data histogram
#set style fill solid 1.0 border 0
#set style histogram clustered gap 1
#set boxwidth 1 absolute
set boxwidth 0.4 absolute

set style histogram rowstacked title offset character 0, 0, 0
set style data histograms

set border 1+2

unset xtics

#unset key

#set xtics ('CNS' 1, 'ZNS' 2)

set label "6.0ms" at screen 0.35, 0.168 font "Helvetica, 35" tc rgb "black"

set xtics nomirror
set xtics font "Helvetica, 37" offset 0, 0.3 

plot \
     'total_gc_phase_analysis_data_jw_manually' using ($12/1000):xtic(1) fs pattern 3 lc 'blue' t 'Write', \
     '' using ($7/1000) fs pattern 3 lc 'red' t 'Read', \
     '' using (($4+$5+$6)/1000) fs pattern 3 lc 'orange' t 'Preprocess', \
     '' using ($2/1000) fs pattern 3 lc 'black' t 'Checkpoint', \
#     'total_blk_gc_phase_analysis_data' using ($12/1000):xtic(1) fs pattern 3 lc 'blue' notitle , \
 #    '' using ($7/1000) fs pattern 3 lc 'red' notitle , \
  #   '' using (($4+$5+$6)/1000) fs pattern 3 lc 'orange' notitle , \
   #  '' using ($2/1000) fs pattern 3 lc 'black' notitle , \
