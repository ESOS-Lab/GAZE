#kiops
set terminal postscript eps enhanced color dashed dashlength 3 \
	                linewidth 2 rounded font "Helvetica, 32"

fn(v) = sprintf("%.1f", v)
fnn(v) = sprintf("%d", v)
jw_fnn(v) = (v < 100)? fn(v) : fnn(v)

#set output "./graph_fio_cmp_kiops.eps"
set output "./Fig-18.Macrobenchmark_throughput.eps"
set term postscript size 7.5,3.
set key outside top horizontal reverse Left font "Helvetica, 32"

set key samplen 1 width 0.2

set xtics nomirror
set ytics nomirror

set xtics font "Helvetica, 38" offset 0, 0.3 

set xrange[0.5:4.5]
# Paper env: keep the hardcoded normalized-throughput scale from SOSP26.
# Other envs: autoscale (local numbers aren't normalized to paper's peak).
if (!exists("PAPER_ENV")) PAPER_ENV = 1
if (PAPER_ENV == 1) {
    set yrange[0:1.4]
    set ytics 1 font "Helvetica, 38" offset 0.7, 0
} else {
    set yrange [0:*]
    set ytics font "Helvetica, 38" offset 0.7, 0
}
set key at 3.5, 3.2

set ylabel font "Helvetica, 38" "Normalized\nThroughput" offset 0.1, 0

set lmargin at screen 0.12
set rmargin at screen 0.99
set bmargin at screen 0.23
set tmargin at screen 0.98

set style data histogram
set style fill solid 1.0 border 0
set style histogram clustered gap 1
set boxwidth 1 absolute

set border 11

unset key

plot 'throughput' \
		  u ($3/$3):xtic(1) t 'GAZE' lc 'red', \
		 '' u ($2/$3):xtic(1) t 'IPLFS' lc 'orange', \
		 '' u ($6/$3):xtic(1) t 'PGC' lc 'green', \
		 '' u ($7/$3):xtic(1) t 'COPY' lc 'skyblue', \
		 '' u ($5/$3):xtic(1) t 'F2FS' lc 'black', \
                 '' u ($0):($6/$3):(jw_fnn(($6)))  with labels rotate by 90 font "Helvetica, 38" offset 0,1.6 notitle, \
                 '' u ($0-0.17):($2/$3):(jw_fnn(($2)))  with labels rotate by 90 font "Helvetica, 38" offset 0,1.6 notitle, \
                 '' u ($0-0.34):($3/$3):(jw_fnn(($3)))  with labels rotate by 90 font "Helvetica, 38" offset 0,1.6 notitle, \
                 '' u ($0+0.17):($7/$3):(jw_fnn(($7)))  with labels rotate by 90 font "Helvetica, 38" offset 0,1.6 notitle, \
                 '' u ($0+0.34):($5/$3):(jw_fnn(($5)))  with labels rotate by 90 font "Helvetica, 38" offset 0,1.6 notitle \
