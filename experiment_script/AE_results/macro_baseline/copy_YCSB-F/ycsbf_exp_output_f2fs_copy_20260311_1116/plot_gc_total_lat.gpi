# Define a function to divide by 1000.0
fn(x) = ((x) / 1000.0)

set terminal postscript eps enhanced color dashed dashlength 3 \
                     linewidth 2 rounded font "Helvetica, 40"

set output 'total_per_sec_gc_latency_graph-one_dogc_only.eps'

set term postscript size 7.5,2.8+0.4+0.2

set grid ytics
set key outside top center horizontal samplen 1 font "Helvetica, 34"

set xlabel "Time (sec)" offset 0, 0.5
set ylabel "Latency (msec)" offset 1.4, 0 # y축 단위를 msec로 수정

set xtics 100
set xtics nomirror
set ytics nomirror
set border 3
set yrange [0:800]
set ytics 100
unset grid
set xrange [0:400] # x축 범위 자동 조정

# Define colors for each category
set style line 1 lc rgb "black"         lw 2 # cp
set style line 3 lc rgb "dark-violet"   lw 2 # filemap
set style line 4 lc rgb "blue"          lw 2 # pcache
set style line 5 lc rgb "red"           lw 2 # read
set style line 6 lc rgb "green"         lw 2 # write
set style line 7 lc rgb "orange"        lw 2 # others

# Set box width to be very small and no borders
set boxwidth 0.1 absolute
set style fill solid


#set tmargin at screen 0.0
set lmargin at screen 0.17
#set rmargin at screen 0.91
set tmargin at screen 0.86
#set bmargin at screen 0.26



# Pre-calculate the latency sums and apply the function f(x)
#set datafile separator ","
plot \
    'gc_lat_per_sec_one_gc' using ($1):(fn($4)) title "Total GC" with impulses ls 5, \
    'gc_lat_per_sec_one_gc' using ($1):(fn($5)) title "Do GC" with impulses ls 4

